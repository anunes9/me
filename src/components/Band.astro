---
import { band } from '../data/profile';
import ExternalLink from './ExternalLink.astro';
---

<section class="band" aria-labelledby="band-title">
  <div>
    <h2 id="band-title" class="serif">{band.headlineLead} <em>{band.headlineAccent}</em>?</h2>
    <p>{band.line}</p>
  </div>
  <ExternalLink href={band.cta.href} class="btn">{band.cta.label} →</ExternalLink>
</section>

<style>
  .band {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    margin-top: 14px;
    padding: 30px 28px;
    border-radius: var(--radius-card);
    background: var(--ink);
    color: var(--bg);
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 34px);
    line-height: 1.1;
    margin-bottom: 8px;
    text-wrap: balance;
  }
  em {
    font-style: italic;
    color: var(--accent);
  }
  p {
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--bg) 72%, var(--ink));
  }
  .btn {
    background: var(--bg);
    color: var(--ink);
    border-color: transparent;
    white-space: nowrap;
    flex: none;
  }
  @media (min-width: 860px) {
    .band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 34px 36px;
    }
  }
</style>
