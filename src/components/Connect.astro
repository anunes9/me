---
import { connect, links } from '../data/profile';
import ExternalLink from './ExternalLink.astro';
import CopyEmail from './CopyEmail.astro';
---

<article class="card span-5">
  <h2 class="label">Connect</h2>
  <ul class="links">
    <li>
      <ExternalLink href={links.linkedin}>LinkedIn <span class="handle print-hide">{connect.linkedinHandle}</span><span class="print-only">linkedin.com/in/{connect.linkedinHandle}</span></ExternalLink>
    </li>
    <li>
      <ExternalLink href={links.github}>GitHub <span class="handle print-hide">{connect.githubHandle}</span><span class="print-only">github.com/{connect.githubHandle}</span></ExternalLink>
    </li>
    <CopyEmail />
  </ul>
</article>

<style>
  .links {
    display: flex;
    flex-direction: column;
    margin-top: 2px;
  }
  .links > li:not(:last-child) a {
    border-bottom: 1px solid var(--line);
  }
  .links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 40px;
    padding: 8px 0;
    font-size: 14px;
    transition: color 0.16s var(--ease);
  }
  .links a:hover .handle {
    color: var(--ink);
  }
  .handle {
    font-size: 12px;
    color: var(--muted);
    overflow-wrap: anywhere;
    text-align: right;
    transition: color 0.16s var(--ease);
  }
</style>
