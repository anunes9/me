---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Strip from '../components/Strip.astro';
import Grid from '../components/Grid.astro';
import AiWork from '../components/AiWork.astro';
import About from '../components/About.astro';
import BasedIn from '../components/BasedIn.astro';
import Experience from '../components/Experience.astro';
import Toolbox from '../components/Toolbox.astro';
import Connect from '../components/Connect.astro';
import { meta } from '../data/profile';
---

<Base title={meta.title} description={meta.description}>
  <Nav slot="nav" />
  <div class="wrap">
    <Hero />
    <Strip />
    <Grid>
      <AiWork />
      <About />
      <BasedIn />
      <Experience />
      <Toolbox />
      <Connect />
    </Grid>
  </div>
</Base>
